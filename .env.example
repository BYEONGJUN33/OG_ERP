# 값은 절대 커밋하지 않는다. 실제 값은 .env.local 과 Vercel 환경변수에만 둔다.
# 여기 있는 값은 비밀이 아닌 것(식별자·도메인)만 채워져 있다.

# Airtable — 서버에서만 사용한다. NEXT_PUBLIC_ 접두어를 붙이지 마라.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appzLstFHtHcQlWSu

# Auth.js v5 (Google)
# AUTH_SECRET 생성: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 로컬 개발에서만 필요. Vercel 에서는 설정하지 않는다.
AUTH_URL=http://localhost:3000

# 로그인 허용 도메인. 서버 콜백에서 이메일 도메인을 다시 검증한다.
ALLOWED_HD=open-garden.co.kr

# 한 화면에 겹쳐 볼 구글 캘린더 ID. 여러 개면 쉼표로 나열한다.
# 맨 앞이 기본 캘린더 — [일정 추가]는 거기에 만든다.
# 예: 공용,개인,대한민국 공휴일(ko.south_korea#holiday@group.v.calendar.google.com)
GOOGLE_CALENDAR_ID=
